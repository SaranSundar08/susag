<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diffdrive_robot">
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_mock_hardware" default="false"/>

  <!-- Include the macro file ONCE -->
  <xacro:include filename="$(find susag_bringup)/urdf/susag_updated_model.xacro"/>
  <!-- Include ros2_control xacro ONCE -->
  <xacro:include filename="$(find susag_bringup)/urdf/susag_diffbot.ros2_control.xacro"/>

  <!-- Instantiate your robot -->
  <xacro:diffbot prefix="$(arg prefix)"/>

  <!-- Attach ros2_control hardware/controller -->
  <xacro:diffbot_ros2_control
    name="DiffBot" prefix="$(arg prefix)" use_mock_hardware="$(arg use_mock_hardware)"/>
    
</robot>
