<?xml version="1.0" ?>
<robot name="susag_robot" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="body_color" value="Gazebo/Silver" />
<xacro:property name="wheel_color" value="Gazebo/Black" />
<xacro:property name="lidar_color" value="Gazebo/Red" />
<xacro:property name="camera_color" value="Gazebo/Blue" />

<gazebo>
  <plugin name="control" filename="libgazebo_ros_control.so"/>
</gazebo>
<gazebo reference="base_link">
  <material>${body_color}</material>
  <mu1>0.1</mu1>
  <mu2>0.1</mu2>
  <self_collide>true</self_collide>
  <gravity>true</gravity>
</gazebo>

<gazebo reference="right_wheel_back_1">
  <material>${wheel_color}</material>
  <mu1>1200</mu1>
  <mu2>1200</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="right_wheel_front_1">
  <material>${wheel_color}</material>
  <mu1>1200</mu1>
  <mu2>1200</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="left_wheel_front_1">
  <material>${wheel_color}</material>
  <mu1>1200</mu1>
  <mu2>1200</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="left_wheel_back_1">
  <material>${wheel_color}</material>
  <mu1>1200</mu1>
  <mu2>1200</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="lidar_1">
  <material>${lidar_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="rgbdcam_1">
  <material>${camera_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo>
  <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
    <update_rate>500</update_rate>
    <num_wheel_pairs>2</num_wheel_pairs>

    <!-- LEFT side -->
    <left_joint>left_wheel_back_joint</left_joint>
    <left_joint>left_wheel_front_joint</left_joint>

    <!-- RIGHT side -->
    <right_joint>right_wheel_back_joint</right_joint>
    <right_joint>right_wheel_front_joint</right_joint>


    <wheel_separation>0.6</wheel_separation>
    <wheel_diameter>0.2</wheel_diameter>  

    <wheel_separation>0.6</wheel_separation>
    <wheel_diameter>0.2</wheel_diameter>  

    <!-- Limits-->
    <max_wheel_torque>40</max_wheel_torque>
    <max_wheel_acceleration>10.0</max_wheel_acceleration>

    <!-- Outputs -->
    <publish_odom>true</publish_odom>
    <publish_odom_tf>true</publish_odom_tf>   
    <publish_wheel_tf>false</publish_wheel_tf>

    <odometry_frame>odom</odometry_frame>
    <robot_base_frame>base_link</robot_base_frame>
  </plugin>
</gazebo>

<!-- LIDAR plugin -->
<gazebo reference="lidar_1">
  <sensor type="ray" name="lidar_sensor">
    <pose>0 0 0 0 0 0</pose>
    <update_rate>30</update_rate>
    <visualize>false</visualize>

    <ray>
      <scan>
        <horizontal>
          <samples>720</samples>
          <resolution>1</resolution>
          <min_angle>-3.141592653589793</min_angle>
          <max_angle>3.141592653589793</max_angle>
        </horizontal>
      </scan>

      <range>
        <min>0.1</min>
        <max>12.0.0</max>
        <resolution>0.01</resolution>
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.02</stddev>
      </noise>
    </ray>

    <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
      <ros>
        <!-- <namespace>/susag</namespace> -->
        <remapping>~/out:=scan</remapping>
      </ros>
      <output_type>sensor_msgs/LaserScan</output_type>
      <frame_name>lidar_1</frame_name> 
    </plugin>
  </sensor>
</gazebo>


<!-- D435-like depth camera -->
<gazebo reference="rgbdcam_1">
  <sensor type="depth" name="depth_camera_sensor">
    <update_rate>30</update_rate>            <!-- 30 Hz typical -->
    <always_on>1</always_on>
    <pose>0 0 0 0 0 0</pose>

    <camera name="depth_camera">
      <!-- 86–87° H-FOV ≈ 1.50 rad (your 60° = 1.047 was too narrow) -->
      <horizontal_fov>1.50</horizontal_fov>

      <!-- Use a 16:9 depth mode like the real camera -->
      <image>
        <width>1280</width>                  <!-- or 848 for lighter sim -->
        <height>720</height>                 <!-- 1280x720 matches spec -->
        <format>R8G8B8</format>              <!-- color buffer format (ok) -->
      </image>

      <!-- Clip to realistic working range -->
      <clip>
        <!-- D435 Min-Z ~0.28 m @ max res; use 0.1–0.28 if you need closer -->
        <near>0.28</near>
        <far>10.0</far>                      <!-- workable long range -->
      </clip>

      <!-- Keep depth imager distortion off; Gazebo pinhole model -->
      <distortion>
        <k1>0.0</k1><k2>0.0</k2><k3>0.0</k3>
        <p1>0.0</p1><p2>0.0</p2>
        <center>0.5 0.5</center>
      </distortion>
    </camera>

    <plugin name="depth_camera_plugin" filename="libgazebo_ros_camera.so">
      <ros>
        <namespace>susag/depth</namespace>
        <remapping>~/image:=depth_camera/image_raw</remapping>
        <remapping>~/camera_info:=depth_camera/camera_info</remapping>
        <remapping>~/depth_image:=depth_camera/depth/image_raw</remapping>
        <remapping>~/depth_camera_info:=depth_camera/depth/camera_info</remapping>
        <remapping>~/points:=depth_camera/points</remapping>
      </ros>

      <camera_name>depth_camera</camera_name>
      <frame_name>rgbdcam_1_optical</frame_name>

      <!-- Set the real stereo baseline (was 0.07 m) -->
      <hack_baseline>0.05</hack_baseline>

      <!-- Keep consistent with <clip><near> -->
      <min_depth>0.28</min_depth>
    </plugin>

    <!-- Optional noise to mimic <~2% error @ 2 m -->
    <noise>
      <type>gaussian</type>
      <mean>0.0</mean>
      <!-- 2% of 2 m ≈ 4 cm; scale down for sim stability -->
      <stddev>0.02</stddev>   <!-- meters of depth noise; tune 0.005–0.02 -->
    </noise>
  </sensor>
</gazebo>



<!-- IMU  -->
<gazebo reference="imu_link">
  <sensor name="imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>100.0</update_rate>
    <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
      <ros>
        <remapping>~/out:=imu/data</remapping> 
      </ros>
      <gaussianNoise>0.01</gaussianNoise>
      <frameName>imu_link</frameName>
    </plugin>
  </sensor>
</gazebo>

</robot>
