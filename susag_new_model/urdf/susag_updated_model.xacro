</joint>

<joint name="laser_center_joint" type="fixed">
  <origin xyz="0 0 0.34" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="laser_center_link"/>
</joint>

<joint name="imu_joint" type="fixed">
  <origin xyz="-0.381 0.02 0.24" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="imu_link"/>
