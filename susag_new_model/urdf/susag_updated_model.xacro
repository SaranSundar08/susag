</joint>

<joint name="real_sense_joint" type="fixed">
  <origin xyz="0.436 0.0 0.27" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="real_sense_1"/>
</joint>

<joint name="lidar_rear_joint" type="fixed">
  <origin xyz="-0.381 0.0 0.34" rpy="0 0 ${pi}"/>
  <parent link="base_link"/>
  <child link="rear_lidar_1"/>
</joint>

<joint name="lidar_front_joint" type="fixed">
  <origin xyz="0.381 0.0 0.34" rpy="0 0 0"/>
