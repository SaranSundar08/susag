<?xml version="1.0" ?>
<robot name="susag_robot" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="body_color" value="Gazebo/Silver" />
<xacro:property name="wheel_color" value="Gazebo/Black" />
<xacro:property name="lidar_color" value="Gazebo/Red" />
<xacro:property name="camera_color" value="Gazebo/Blue" />

<gazebo>
  <plugin name="control" filename="libgazebo_ros_control.so"/>
</gazebo>
<gazebo reference="base_link">
  <material>${body_color}</material>
  <mu1>0.1</mu1>
  <mu2>0.1</mu2>
  <self_collide>true</self_collide>
  <gravity>true</gravity>
</gazebo>

<gazebo reference="right_wheel_back_1">
  <material>${wheel_color}</material>
  <mu1>1200</mu1>
  <mu2>1200</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="right_wheel_front_1">
  <material>${wheel_color}</material>
  <mu1>1200</mu1>
  <mu2>1200</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="left_wheel_front_1">
  <material>${wheel_color}</material>
  <mu1>1200</mu1>
  <mu2>1200</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="left_wheel_back_1">
  <material>${wheel_color}</material>
  <mu1>1200</mu1>
  <mu2>1200</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="lidar_1">
  <material>${lidar_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="rgbdcam_1">
  <material>${camera_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>


<!-- skid steering mechanism  -->
<gazebo>
  <plugin name='diff_drive' filename='libgazebo_ros_diff_drive.so'>
    <ros>
      <namespace>/</namespace>
      <remapping>cmd_vel:=/cmd_vel</remapping>
      <remapping>odom:=/odom</remapping>
    </ros>
    <update_rate>100.0</update_rate>
    <left_joint>left_wheel_back_joint</left_joint>
    <right_joint>right_wheel_back_joint</right_joint>
    <wheel_separation>0.5</wheel_separation>
    <wheel_diameter>0.15</wheel_diameter>
    <odometry_frame>odom</odometry_frame>
    <robot_base_frame>base_link</robot_base_frame>
    <publish_odom_tf>true</publish_odom_tf>
    <publish_odom>true</publish_odom>
    <max_wheel_torque>50</max_wheel_torque>
    <max_acceleration>1.0</max_acceleration>
  </plugin>
</gazebo>

<!-- lidar plugins -->
<gazebo reference="lidar_1">
  <sensor type="ray" name="lidar_sensor">
    <pose>0 0 0 0 0 0</pose>
    <update_rate>30</update_rate>
    <visualize>true</visualize>
    <ray>
      <scan>
        <horizontal>
          <samples>720</samples>
          <resolution>1</resolution>
          <min_angle>-1.570796</min_angle>
          <max_angle>1.570796</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.1</min>
        <max>4.0</max>
        <resolution>0.01</resolution>
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.01</stddev>
      </noise>
    </ray>

    <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
      <ros>
        <!-- Set the namespace if you want, or omit to stay in root -->
        <!-- <namespace>/susag</namespace> -->
        <remapping>~/out:=scan</remapping>
      </ros>
      <output_type>sensor_msgs/LaserScan</output_type>
      <frame_name>lidar_1</frame_name> <!-- Optional: defaults to link name -->
    </plugin>
  </sensor>
</gazebo>


<!-- depth camera plugin  -->
<gazebo reference="rgbdcam_1">
  <sensor type="depth" name="depth_camera_sensor">
    <update_rate>30</update_rate>
    <always_on>1</always_on>
    
    <pose>0 0 0 0 0 0</pose>

    <camera name="depth_camera">
      <horizontal_fov>1.047</horizontal_fov> <!-- 60 degrees -->
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.05</near>
        <far>10.0</far>
      </clip>
      <distortion>
        <k1>0.0</k1>
        <k2>0.0</k2>
        <k3>0.0</k3>
        <p1>0.0</p1>
        <p2>0.0</p2>
        <center>0.5 0.5</center>
      </distortion>
    </camera>

    <plugin name="depth_camera_plugin" filename="libgazebo_ros_camera.so">
      <ros>
        <namespace>susag/depth</namespace>
        <remapping>depth_camera/image_raw:=depth_camera/depth_image</remapping>
        <remapping>depth_camera/image_depth:=depth_camera/depth_image_raw</remapping>
        <remapping>depth_camera/camera_info:=depth_camera/depth_camera_info</remapping>
        <remapping>depth_camera/camera_info_depth:=depth_camera/depth_camera_info_depth</remapping>
        <remapping>depth_camera/points:=depth_camera/points</remapping>
      </ros>

      <camera_name>depth_camera</camera_name>
      <frame_name>rgbdcam_1</frame_name>
      <hack_baseline>0.07</hack_baseline>
      <min_depth>0.05</min_depth>
    </plugin>
  </sensor>
</gazebo>


<!-- IMU  -->
<gazebo reference="imu_link">
  <sensor name="imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>100.0</update_rate>
    <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
      <ros>
        <remapping>~/out:=imu/data</remapping> 
      </ros>
      <gaussianNoise>0.01</gaussianNoise>
      <frameName>imu_link</frameName>
    </plugin>
  </sensor>
</gazebo>

</robot>
